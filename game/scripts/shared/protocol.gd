class_name Protocol
extends RefCounted
## Interface contract between client and server. MANAGER-OWNED: agents do not edit this file.
##
## Every message is one JSON object sent as one WebSocket text frame: {"t": <type>, ...fields}.
## Field names are the F_* constants. Positions are arrays [x, y, z] of floats (metres).
## A bug on the wire is an array [id: int, x: float, y: float, z: float, colour: int].

# === TRANSPORT ===
const DEFAULT_PORT: int = 3311
const WS_PATH: String = "/bugs-and-lizards/ws"
const POS_HZ: float = 10.0 # client position reports per second
const MAX_SPEED: float = 6.0 # m/s; server rejects faster reported motion (with 50% slack)
const CAPTURE_RANGE: float = 2.5 # metres from the lizard's reported position to the bug
const MAX_SESSIONS: int = 8
const MAX_MESSAGE_BYTES: int = 65536 # client-to-server; larger frames are dropped

# === FIELDS ===
const F_TYPE: String = "t"
const F_CODE: String = "code" # session code, 4 digits as a String
const F_NAME: String = "name"
const F_NAMES: String = "names"
const F_TOKEN: String = "token" # seat token (student) or teacher token
const F_ROOM: String = "room" # int, 0-based
const F_ROUND: String = "round" # int, 1-based
const F_STAGE: String = "stage" # int 1..4
const F_SECONDS: String = "seconds"
const F_BUGS: String = "bugs" # Array of wire bugs
const F_BUG_ID: String = "id"
const F_POS: String = "p"
const F_YAW: String = "yaw"
const F_COUNT: String = "count" # this player's accepted captures this hunt
const F_REASON: String = "reason"
const F_TIME: String = "time" # client clock (msec) echoed by pong
const F_STATE: String = "state" # Dictionary, see the message notes
const F_SUMMARY: String = "summary" # Dictionary, see SUMMARY
const F_CONFIG: String = "config" # Dictionary, see CONFIGURE
const F_ASSIGN: String = "assign" # Dictionary name -> room int
const F_LIZARDS: String = "lizards" # Array of names
const F_VALUE: String = "value"

# === CLIENT -> SERVER ===
const PING: String = "ping" # {time}
const CREATE_SESSION: String = "create_session" # teacher: {names: [String]} -> SESSION_CREATED
const TEACHER_REJOIN: String = "teacher_rejoin" # {code, token} -> TEACHER_STATE
const LOOKUP: String = "lookup" # student: {code} -> ROSTER
const PICK_NAME: String = "pick_name" # student: {code, name} -> JOINED or ERROR
const REJOIN: String = "rejoin" # student: {code, token} -> JOINED (+ HUNT_START if mid-hunt and hunting)
const POSITION: String = "pos" # hunter: {p, yaw}, about POS_HZ times a second while hunting
const CAPTURE: String = "capture" # hunter: {id} -> CAPTURE_OK or CAPTURE_REJECTED
# Teacher commands. All carry {token}. Session-wide unless they name a room.
const CONFIGURE: String = "configure" # {config: {stage, rooms, bugs_start, lizards_start, hunt_seconds, bug_budget}, assign}
const SET_LIZARDS: String = "set_lizards" # {room, lizards: [names]} starting lizards, round 1 only
const START_HUNT: String = "start_hunt" # every room not paused or ended
const STOP_HUNT: String = "stop_hunt" # ends running hunts now
const ADVANCE: String = "advance" # every room in STUDY goes to the next round (or ends)
const PAUSE_ROOM: String = "pause_room" # {room, value: bool} a paused room skips START_HUNT
const RESET_ROOM: String = "reset_room" # {room} back to round 1 with the current config
const RELEASE_SEAT: String = "release_seat" # {name} frees the name so it can be picked again
const SET_DEBUG_BUGS: String = "set_debug_bugs" # {value: int} overrides bugs_start for every room (pressure test)

# === SERVER -> CLIENT ===
const PONG: String = "pong" # {time}
const ERROR: String = "error" # {reason}
const SESSION_CREATED: String = "session_created" # {code, token}
const ROSTER: String = "roster" # {code, names: [{name, taken: bool}]}
const JOINED: String = "joined" # {name, token, room}
const HUNT_START: String = "hunt_start" # hunters only: {room, round, seconds, bugs, p (start area), count}
const BUG_GONE: String = "bug_gone" # hunters in the room: {id}
const CAPTURE_OK: String = "capture_ok" # {id, count}
const CAPTURE_REJECTED: String = "capture_rejected" # {id, reason}
const HUNT_END: String = "hunt_end" # everyone in the room: {room, round}
const SUMMARY: String = "summary" # everyone in the room: {room, summary}
const ROOM_STATE: String = "room_state" # students: {room, state} public counts only, never bug positions
const TEACHER_STATE: String = "teacher_state" # teacher: {code, state}

# Reasons
const R_BAD_CODE: String = "bad_code"
const R_NAME_TAKEN: String = "name_taken"
const R_NOT_TEACHER: String = "not_teacher"
const R_TOO_MANY_SESSIONS: String = "too_many_sessions"
const R_NOT_HUNTING: String = "not_hunting"
const R_GONE: String = "gone" # bug already captured
const R_RANGE: String = "range"
const R_BAD_TOKEN: String = "bad_token"

# Room phases (state.phase)
const PH_SETUP: String = "setup" # before round 1's hunt
const PH_HUNT: String = "hunt"
const PH_STUDY: String = "study" # summary shown, waiting for ADVANCE
const PH_ENDED: String = "ended"

## SUMMARY.summary keys: round, stage, bugs_start, BUGS (= bugs uncaught), bugs_next_start, LIZARDS,
## MUTANTS, starved: [names], survived: [names], captures: {name: int}, hunt_seconds (actual),
## ended: bool, end_reason: String, history: [record...] (RoundRules records, round 1..n).
##
## ROOM_STATE.state / TEACHER_STATE.state.rooms[i] keys: room, phase, round, stage, paused,
## bugs_start, caught, remaining, seconds_left, hunters: [names], members: [names], history.
## TEACHER_STATE.state also has: config, roster: [{name, room, taken, connected}], code.


# === HELPERS ===
static func encode(type: String, fields: Dictionary = {}) -> String:
	var msg: Dictionary = fields.duplicate()
	msg[F_TYPE] = type
	return JSON.stringify(msg)


## Returns {} for anything that is not a JSON object with a String "t".
static func decode(text: String, max_bytes: int = MAX_MESSAGE_BYTES) -> Dictionary:
	if text.length() > max_bytes:
		return {}
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		return {}
	var msg: Dictionary = parsed
	if typeof(msg.get(F_TYPE)) != TYPE_STRING:
		return {}
	return msg


static func vec_to_wire(v: Vector3) -> Array:
	return [snappedf(v.x, 0.01), snappedf(v.y, 0.01), snappedf(v.z, 0.01)]


static func wire_to_vec(a: Variant) -> Vector3:
	if typeof(a) != TYPE_ARRAY or (a as Array).size() != 3:
		return Vector3.INF
	var arr: Array = a
	for x: Variant in arr:
		if typeof(x) != TYPE_FLOAT and typeof(x) != TYPE_INT:
			return Vector3.INF
	return Vector3(float(arr[0]), float(arr[1]), float(arr[2]))
